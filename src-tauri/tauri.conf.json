{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memojjang",
  "version": "0.3.1",
  "identifier": "com.memojjang.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "메모짱",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 320,
        "center": true,
        "decorations": false,
        "visible": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' blob: data: https:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' blob: data: ipc: http://ipc.localhost"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MyNameIsDabin/MEMOJJANG/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMTVBRjA3QTk3QUVGRDIKUldUUzczcXBCNjhWZjE3UWYyR2hyUGtzTVF0Q3piaHRWc1lGOVgvVFhLMFVDMERuYjFZdjlrcVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
